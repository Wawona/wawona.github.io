# Copy this to .env locally if you are not using pass/SecretSpec.
# Never commit .env. Prefer: ./scripts/site-env.sh <command>
# Local .env is sandbox only (pk_test_ / sk_test_). Live keys stay off this machine's serve path.
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CHECKOUT_API=http://127.0.0.1:4242
STRIPE_CHECKOUT_PORT=4242
STRIPE_CHECKOUT_ORIGINS=http://127.0.0.1:1111,http://localhost:1111,https://wawona.io
SURVEY_DASHBOARD_TOKEN=
